# Copy to .env and fill in. NEVER commit .env (gitignored).

# Supabase Management API token (migrations via scripts/apply_migration.py)
SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# Google Cloud key — Street View Static + Map Tiles (offline capture only)
GOOGLE_MAPS_API_KEY=your_google_key_here

# Tripo 3D reconstruction API
TRIPO_API_KEY=your_tripo_key_here

# Naver Cloud Platform Maps (see NAVER_SETUP.md for the console walkthrough)
# Used BUILD-TIME only (geocoding + offline map reference); the client never
# sees these — the Client Secret must never ship in browser JS.
NAVER_MAPS_CLIENT_ID=your_naver_client_id_here
NAVER_MAPS_CLIENT_SECRET=your_naver_client_secret_here

# VWorld open Data API (digital-twin geometry: official Korean building
# registry footprints/floors/heights — see NAVER_SETUP.md § VWorld)
VWORLD_API_KEY=your_vworld_key_here
